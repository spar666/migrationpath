# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files (sensitive)
.env
.env.local
.env.*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Package manager lockfiles (keep only package-lock.json)
bun.lockb
yarn.lock
.yarn/
.yarnrc.yml

# TypeScript incremental build cache
*.tsbuildinfo

# Editor and coding-agent scratch directories
.claude/
.continue/
.lovable/
.antigravitycli/

# Test output. Playwright rewrites both on every run; test-results/ holds the
# screenshots and videos of the last failures, which are worth reading and not
# worth committing.
playwright-report/
test-results/
blob-report/
.playwright/

# Vite/Vitest write one of these next to the config each time they load a TS
# config file. They are transient and accumulate quickly.
*.timestamp-*.mjs
