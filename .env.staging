# Staging Environment Variables
# Used for pre-production testing

# API Configuration
VITE_API_BASE_URL=
VITE_API_DEBUG=true
VITE_REQUEST_TIMEOUT=10000
VITE_MAX_RETRIES=3

# CORS Configuration for Staging
VITE_ALLOWED_ORIGINS=*
VITE_ALLOWED_CORS_HEADERS=Content-Type,Authorization,X-Requested-With

# Environment
APP_NAME=MigrationPath Staging
APP_VERSION=1.0.0-SNAPSHOT

# Performance
VITE_BUILD_MODE=production
VITE_OPTIMIZE_IMAGES=true

# Logging (enable debug in staging)
VITE_LOG_LEVEL=info

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_LOGGING=true

# Lead-gen funnel
# Point staging at a SEPARATE Calendly event type from production, or test
# bookings land in the agents' real calendars.
VITE_CALENDLY_CONSULT_URL=https://calendly.com/studyandvisa-au/initial-consultation
