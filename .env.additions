# ---------------------------------------------------------------------------
# Lead-gen funnel — add these to .env / .env.staging / .env.production
# ---------------------------------------------------------------------------

# The Calendly event type the consult is booked against.
# lib/booking.ts appends the prospect id to this URL as utm_content, which is
# how the Calendly webhook links the booking back to the prospect record.
VITE_CALENDLY_CONSULT_URL=https://calendly.com/<org>/consultation
