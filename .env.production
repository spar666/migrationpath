# Production Environment - Vercel
# Sensitive values should be set in Vercel dashboard

# API Configuration
VITE_API_BASE_URL=
VITE_API_DEBUG=false
VITE_REQUEST_TIMEOUT=15000
VITE_MAX_RETRIES=2

# CORS Configuration for Production
VITE_ALLOWED_ORIGINS=https://migrationpath.com.au,www.migrationpath.com.au,https://www.migrationpath.com.au
VITE_ALLOWED_CORS_HEADERS=Content-Type,Authorization,X-Requested-With

# Environment
APP_NAME=MigrationPath
APP_VERSION=1.0.0

# Performance
VITE_BUILD_MODE=production
VITE_OPTIMIZE_IMAGES=true

# Logging (disable verbose logging in production)
VITE_LOG_LEVEL=error

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_LOGGING=false

# Lead-gen funnel
# The Calendly event type the consultation is booked against. Required — the
# Book button on the pre-screen result cannot work without it.
# Set the real value in the Vercel dashboard, not here.
VITE_CALENDLY_CONSULT_URL=
